<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_inherit_mrp_costing" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.mrp.costing</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="mrp.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@name='process_operations_setting_container']" position="after">
                <block title="Manufacturing Process Costing" name="mrp_costing_setting_container">
                    <setting id="mrp_costing_method" help="Select how to calculate manufacturing process costs.">
                        <field name="mrp_costing_method" widget="radio"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
