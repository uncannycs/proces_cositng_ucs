<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="mrp_workcenter_view_form_inherit_mrp_costing" model="ir.ui.view">
        <field name="name">mrp.workcenter.view.form.inherit.mrp.costing</field>
        <field name="model">mrp.workcenter</field>
        <field name="inherit_id" ref="mrp.mrp_workcenter_view"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='capacity']" position="after">
                <group string="Process Costing" name="mrp_process_costing">
                    <field name="labor_costs_hour"/>
                    <field name="overhead_costs_hour"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
